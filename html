<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <style>
        body { background: #121417; color: #E0E0E0; font-family: 'Inter', sans-serif; margin: 0; padding: 20px; }
        
        /* The Sentience Orb - High Contrast Blue/Yellow for Pet Eyes */
        .orb-container { height: 250px; display: flex; justify-content: center; align-items: center; }
        .orb { 
            width: 160px; height: 160px; 
            background: radial-gradient(circle, #007BFF, #FFD700); 
            border-radius: 50%; 
            box-shadow: 0 0 60px rgba(0, 123, 255, 0.5); 
            animation: petPulse 3s infinite ease-in-out; 
        }
        @keyframes petPulse { 0%, 100% { transform: scale(1); filter: brightness(1); } 50% { transform: scale(1.1); filter: brightness(1.3); } }

        /* Bento Grid - Gray/Blue/Yellow */
        .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-top: 20px; }
        .card { background: #2A2D34; border: 2px solid #3F444E; padding: 20px; border-radius: 24px; position: relative; overflow: hidden; }
        .card.active { border-color: #FFD700; }
        .label { color: #888; font-size: 11px; text-transform: uppercase; font-weight: 800; letter-spacing: 1.5px; }
        .value { color: #FFD700; font-size: 22px; font-weight: bold; display: block; margin-top: 8px; }

        /* Professional Action Button */
        button { 
            background: #007BFF; color: white; border: none; width: 100%; 
            padding: 22px; border-radius: 50px; font-size: 18px; font-weight: 900; 
            margin-top: 35px; cursor: pointer; text-transform: uppercase;
            box-shadow: 0 15px 30px rgba(0, 123, 255, 0.3);
        }
    </style>
</head>
<body>
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <span style="font-weight: 900; color: #FFD700;">PETPULSE <span style="color: #007BFF;">PRO</span></span>
        <span style="font-size: 10px; color: #888;">CHROMOSOME MESH v11.0</span>
    </div>

    <div class="orb-container">
        <div class="orb"></div>
    </div>

    <div class="grid">
        <div class="card active">
            <span class="label">Heart Rate</span>
            <span class="value" id="hr-val">--</span>
        </div>
        <div class="card">
            <span class="label">Resilience</span>
            <span class="value" id="res-val" style="color: #007BFF;">--</span>
        </div>
        <div class="card">
            <span class="label">Thermal</span>
            <span class="value" id="temp-val">--</span>
        </div>
        <div class="card">
            <span class="label">Likability</span>
            <span class="value" id="like-val" style="color: #007BFF;">PEAK</span>
        </div>
    </div>

    <button onclick="triggerScan()">Initiate Omega Scan</button>

    <script>
        async function triggerScan() {
            const btn = document.querySelector('button');
            btn.innerText = "Syncing AI Vet Assistant...";
            const res = await fetch('/scan');
            const data = await res.json();
            
            setTimeout(() => {
                document.getElementById('hr-val').innerText = data.heart_rate;
                document.getElementById('res-val').innerText = data.resilience;
                document.getElementById('temp-val').innerText = data.thermal;
                btn.innerText = "Scan Complete";
                btn.style.background = "#FFD700";
                btn.style.color = "#000";
            }, 1500);
        }
    </script>
</body>
</html>
